@charset "utf-8";

:root { --bg: #0f0f0f; --card: #1a1a1a; --accent: #ff0055; --text: #fff; --hover: #2a2a2a; }

body, html { margin: 0px; padding: 0px; height: 100%; font-family: Inter, sans-serif; background: var(--bg); color: var(--text); overflow: hidden; }

.app-container { display: flex; height: 100vh; width: 100vw; }

.player-section { flex: 2 1 0%; display: flex; flex-direction: column; background: rgb(0, 0, 0); padding: 20px; gap: 15px; box-sizing: border-box; }

.video-container { position: relative; padding-top: 56.25%; background: rgb(0, 0, 0); border-radius: 16px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.5) 0px 10px 30px; }

#main-player { position: absolute; top: 0px; left: 0px; width: 100% !important; height: 100% !important; }

.video-info h1 { margin: 0px; font-size: 1.5rem; font-weight: 600; }

.sidebar { flex: 1 1 0%; min-width: 350px; background: var(--card); display: flex; flex-direction: column; border-left: 1px solid rgba(255, 255, 255, 0.1); }

.search-container { padding: 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }

#channel-search { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.05); color: rgb(255, 255, 255); margin-bottom: 15px; outline: none; }

.category-tabs { display: flex; flex-wrap: wrap; gap: 8px; }

.cat-tab { padding: 6px 12px; border-radius: 20px; background: rgba(255, 255, 255, 0.08); color: rgb(255, 255, 255); font-size: 15px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; }

.cat-tab.active { background: var(--accent); }

.channel-list { list-style: none; margin: 0px; padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 15px; overflow-y: auto; align-content: start; }

.channel-item { background: rgba(255, 255, 255, 0.04); border-radius: 12px; cursor: pointer; text-align: center; transition: 0.2s; border: 2px solid transparent; height: 140px; display: flex; flex-direction: column; align-items: center; justify-content: center; }

.channel-item:hover { background: var(--hover); }

.channel-item.active { border-color: var(--accent); background: rgba(255, 0, 85, 0.05); }

.logo-wrapper { width: 90px; height: 90px; min-height: 60px; min-width: 60px; margin-bottom: 10px; background: rgb(255, 255, 255); border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 8px; box-sizing: border-box; }

.channel-logo { max-width: 100%; max-height: 100%; object-fit: contain; }

.channel-name { font-size: 0.75rem; font-weight: 600; color: rgb(221, 221, 221); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.2; }

@media (max-width: 992px) {
  body, html { overflow: auto; height: auto; }
  .app-container { flex-direction: column; }
  .sidebar { min-width: 100%; height: auto; }
  .channel-list { overflow-y: visible; }
}

@media (max-width: 992px) {
  .player-section { flex: 0 0 auto; }
}

.video-info { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }

.download-btn { padding: 8px 16px; background: var(--accent); color: rgb(255, 255, 255); text-decoration: none; border-radius: 8px; font-weight: 600; transition: 0.2s; }

.download-btn:hover { background: rgb(230, 0, 77); }
