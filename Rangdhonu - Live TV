.close-btn { width: 100%; padding: 12px; border-radius: 12px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: transparent; color: var(--text-gray); font-size: 13px; cursor: pointer; }

.loading-spinner { grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-gray); font-size: 14px; }

.tg-icon-wrap { width: 72px; height: 72px; margin: 0px auto 15px; border-radius: 50%; background: linear-gradient(135deg, rgb(0, 136, 204), rgb(0, 168, 232)); display: flex; align-items: center; justify-content: center; box-shadow: rgba(0, 136, 204, 0.5) 0px 0px 25px; }

.tg-icon-wrap i { font-size: 36px; color: rgb(255, 255, 255); }

.tg-message { color: rgb(156, 163, 175); margin: 10px 0px 20px; font-size: 14px; line-height: 1.6; }

.tg-join-btn { background: linear-gradient(135deg, rgb(0, 136, 204), rgb(0, 168, 232)) !important; color: rgb(255, 255, 255) !important; box-shadow: rgba(0, 136, 204, 0.4) 0px 4px 15px !important; }

.event-source-tabs { display: flex; justify-content: center; gap: 10px; margin: 10px 0px 20px; flex-wrap: wrap; }

.source-tab { padding: 8px 28px; border-radius: 12px; background: rgba(30, 41, 59, 0.6); color: rgb(148, 163, 184); border: 1px solid rgb(51, 65, 85); font-weight: 600; font-size: 14px; cursor: pointer; transition: 0.3s; backdrop-filter: blur(10px); }

.source-tab.active { background: linear-gradient(135deg, rgb(239, 68, 68), rgb(220, 38, 38)); color: white; border-color: rgb(239, 68, 68); box-shadow: rgba(239, 68, 68, 0.4) 0px 4px 15px; }

.event-filters { display: flex; flex-direction: column; align-items: center; gap: 10px; margin: 0px 0px 20px; }

.filter-row-main, .filter-row-sub { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

.status-tab { padding: 6px 18px; border-radius: 8px; background: transparent; color: rgb(148, 163, 184); border: 1px solid rgb(51, 65, 85); font-weight: 500; font-size: 12px; cursor: pointer; transition: 0.3s; }

.status-tab.active { background: rgb(59, 130, 246); color: white; border-color: rgb(59, 130, 246); }

.sport-tab { padding: 5px 14px; border-radius: 8px; background: transparent; color: rgb(148, 163, 184); border: 1px solid rgb(30, 41, 59); font-size: 12px; font-weight: 500; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 6px; }

.sport-tab.active { background: rgba(59, 130, 246, 0.15); color: rgb(59, 130, 246); border-color: rgb(59, 130, 246); }

.event-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; max-width: 1400px; margin: 0px auto; }

.event-card { background: rgb(15, 23, 42); border-radius: 14px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.05); display: flex; flex-direction: column; transition: 0.3s; position: relative; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 15px; }

.event-card:hover { transform: translateY(-4px); border-color: rgba(59, 130, 246, 0.4); }

.event-img-wrap { position: relative; width: 100%; aspect-ratio: 16 / 9; background: rgb(30, 41, 59); }

.event-img-wrap img { width: 100%; height: 100%; object-fit: cover; }

.badge-sport { position: absolute; top: 10px; left: 10px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px); padding: 3px 8px; border-radius: 6px; font-size: 10px; color: rgb(226, 232, 240); font-weight: 600; border: 1px solid rgba(255, 255, 255, 0.1); }

.badge-status { position: absolute; top: 10px; right: 10px; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 700; color: white; text-transform: uppercase; }

.badge-status.live { background: rgb(239, 68, 68); animation: 1.8s ease 0s infinite normal none running pulse; }

.badge-status.upcoming { background: rgb(245, 158, 11); }

.badge-status.completed { background: rgb(100, 116, 139); }

.event-info { padding: 12px; display: flex; flex-direction: column; flex: 1 1 0%; }

.event-tournament { font-size: 11px; color: rgb(148, 163, 184); font-weight: 500; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.event-title { font-size: 14px; color: rgb(248, 250, 252); font-weight: 700; margin-bottom: 8px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.event-time { display: flex; align-items: center; gap: 6px; font-size: 11px; color: rgb(148, 163, 184); margin-bottom: 12px; margin-top: auto; }

.event-time i { color: rgb(100, 116, 139); }

.event-action-btn { width: 100%; padding: 10px; border-radius: 8px; font-weight: 600; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; transition: 0.2s; }

.event-action-btn.live { background: linear-gradient(135deg, rgb(59, 130, 246), rgb(37, 99, 235)); color: white; box-shadow: rgba(37, 99, 235, 0.3) 0px 4px 10px; }

.event-action-btn.live:hover { background: rgb(29, 78, 216); }

.event-action-btn.upcoming { background: rgba(51, 65, 85, 0.5); color: rgb(148, 163, 184); cursor: not-allowed; }

.event-action-btn.completed { background: rgb(30, 41, 59); color: rgb(100, 116, 139); cursor: default; }

.iframe-wrapper { width: 100%; aspect-ratio: 16 / 9; background: rgb(0, 0, 0); border-radius: 12px; overflow: hidden; border: 1px solid var(--glass-border); display: flex; justify-content: center; align-items: center; position: relative; }

.iframe-wrapper iframe { width: 100%; height: 100%; object-fit: contain; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.pseudo-fullscreen { position: fixed !important; top: 0px !important; left: 0px !important; width: 100vw !important; height: 100vh !important; z-index: 999999 !important; background: rgb(0, 0, 0) !important; margin: 0px !important; padding: 0px !important; border-radius: 0px !important; }

.pseudo-fullscreen iframe { width: 100% !important; height: 100% !important; }

@media (max-width: 768px) {
  .event-source-tabs { gap: 8px; margin: 10px 0px 15px; justify-content: center; }
  .source-tab { padding: 6px 20px; font-size: 13px; border-radius: 8px; }
  .filter-row-main, .filter-row-sub { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 5px; width: 100%; padding-left: 5px; padding-right: 5px; gap: 6px; }
  .filter-row-main::-webkit-scrollbar, .filter-row-sub::-webkit-scrollbar { display: none; }
  .status-tab, .sport-tab { flex-shrink: 0; }
  .event-grid { grid-template-columns: 1fr; padding: 0px; gap: 12px; }
  .event-card { border-radius: 12px; }
  .event-title { font-size: 14px; }
  .event-action-btn { padding: 8px; font-size: 13px; }
  nav { flex-wrap: wrap; padding: 8px 10px; gap: 6px; }
  .logo { font-size: 16px; gap: 5px; }
  .logo i { font-size: 18px; }
  .nav-links { order: 3; width: 100%; justify-content: center; gap: 14px; margin-top: 4px; }
  .nav-links a { font-size: 12px; font-weight: 600; }
  .nav-right { margin-left: auto; gap: 6px; }
  .search-box { width: 90px; padding: 5px 8px; }
  .search-box input { font-size: 11px; }
  .login-btn { padding: 5px 10px; font-size: 11px; }
  .user-profile img { width: 26px; height: 26px; }
  .category-filters { padding: 12px 10px; gap: 8px; }
  .filter-btn { padding: 6px 14px; font-size: 12px; }
  .plan-posters-section { grid-template-columns: 1fr; gap: 15px; padding: 0px 15px; margin-bottom: 20px; }
  .plan-poster { padding: 18px; gap: 15px; }
  .poster-icon { width: 50px; height: 50px; font-size: 22px; }
  .container { padding: 0px 15px 10px; }
  .channel-card { min-width: 85px; padding: 8px 4px; }
  .logo-wrapper { width: 60px; height: 60px; }
  .grid-view { grid-template-columns: repeat(auto-fill, minmax(85px, 1fr)); gap: 10px; }
  .player-container { padding: 10px; }
  .player-box { padding: 10px; border-radius: 15px; }
  .channel-info img { width: 45px; height: 45px; }
  .channel-info h2 { font-size: 15px; }
  footer { padding: 25px 15px; }
  .footer-contact-info { gap: 15px; flex-direction: column; align-items: center; }
  .player-box .channel-info { flex-direction: column; text-align: center; gap: 5px; }
  #liveEventFullscreenBtn span { display: none; }
  #liveEventFullscreenBtn { padding: 8px !important; }
}

@media (max-width: 480px) {
  nav { padding: 8px; gap: 5px; }
  .logo { font-size: 15px; }
  .logo i { font-size: 17px; }
  .nav-links { gap: 10px; margin-top: 3px; }
  .nav-links a { font-size: 11px; }
  .nav-right { gap: 5px; }
  .search-box { width: 70px; padding: 4px 6px; }
  .search-box input { font-size: 10px; }
  .login-btn { padding: 4px 7px; font-size: 10px; }
  .user-profile img { width: 24px; height: 24px; }
}
