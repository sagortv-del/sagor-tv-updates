<!DOCTYPE html><html lang="en" dir="ltr"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-fa350fb2-ccf1-46c3-82c9-9a7733e6ce80@mhtml.blink" />
  
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0B0F19">
  <title>Service Premium — Online</title>
  <meta name="description" content="Service Premium is online. Our service is running 24/7.">

  <link rel="preconnect" href="https://fonts.googleapis.com/">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;family=Tajawal:wght@400;500;700;800&amp;display=swap" rel="stylesheet">

  
</head>
<body>

  <!-- Top: language switcher -->
  <div class="top">
    <div class="lang-bar" role="group" aria-label="Language">
      <button data-lang="en" type="button" class="active">EN</button>
      <button data-lang="fr" type="button">FR</button>
      <button data-lang="ar" type="button">عربي</button>
      <button data-lang="de" type="button">DE</button>
      <button data-lang="es" type="button">ES</button>
    </div>
  </div>

  <!-- Center stage -->
  <main class="stage">

    <!-- Logo mark -->
    <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
      <defs>
        <linearGradient id="goldGrad" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#F5D78E"></stop>
          <stop offset="100%" stop-color="#B8862F"></stop>
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="14" fill="url(#goldGrad)"></rect>
      <path d="M18 32 L28 42 L46 22" stroke="#0B0F19" stroke-width="4.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>

    <!-- Status pill -->
    <div class="status">
      <span class="pulse"></span>
      <span data-i18n="status">All systems operational</span>
    </div>

    <!-- Headline -->
    <h1 data-i18n-html="title">The service is <em>online</em>.</h1>

    <!-- Meta band -->
    <div class="meta">
      <div class="meta-item">
        <div class="meta-num">99.98<span class="pct">%</span></div>
        <div class="meta-lbl" data-i18n="m_uptime">30d uptime</div>
      </div>
      <div class="meta-div"></div>
      <div class="meta-item">
        <div class="meta-num">24/7</div>
        <div class="meta-lbl" data-i18n="m_support">Support</div>
      </div>
      <div class="meta-div"></div>
      <div class="meta-item">
        <div class="meta-num" id="ts">just now</div>
        <div class="meta-lbl" data-i18n="m_check">Last check</div>
      </div>
    </div>

  </main>

  <!-- Bottom: brand -->
  <div class="foot">
    <div class="brand-foot">
      <span class="fmark">
        <svg viewBox="0 0 24 24" fill="none" stroke="#0B0F19" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 12 L10 16 L18 8"></path>
        </svg>
      </span>
      <span><span class="brand-foot-name">Service</span><span class="brand-foot-sub">PREMIUM</span></span>
    </div>
  </div>

  




</body></html>
