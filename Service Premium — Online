@charset "utf-8";

:root { --ink: #0B0F19; --cream: #FBF8F2; --gold-light: #F5D78E; --gold: #D4A24C; --gold-deep: #8F661F; --green: #2E9D63; --font-display: "Fraunces", Georgia, serif; --font-sans: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; --font-ar: "Tajawal", "Segoe UI", Tahoma, sans-serif; --ease: cubic-bezier(0.22, 1, 0.36, 1); }

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body { margin: 0px; padding: 0px; }

html { text-size-adjust: 100%; }

body { min-height: 100dvh; background: var(--ink); color: var(--cream); font-family: var(--font-sans); display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 20px 16px; position: relative; overflow-x: hidden; -webkit-font-smoothing: antialiased; }

[dir="rtl"] body { font-family: var(--font-ar); }

body::before { content: ""; position: fixed; inset: 0px; background: radial-gradient(circle, rgba(212, 162, 76, 0.18), transparent 55%); pointer-events: none; z-index: 0; animation: 8s ease-in-out 0s infinite normal none running glow; }

@keyframes glow { 
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}

body::after { content: ""; position: fixed; inset: 0px; background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px); background-size: 28px 28px; pointer-events: none; z-index: 0; }

.top { width: 100%; display: flex; justify-content: flex-end; position: relative; z-index: 2; padding: 0px 4px; }

.lang-bar { display: inline-flex; padding: 3px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 999px; backdrop-filter: blur(12px); gap: 1px; max-width: 100%; }

.lang-bar button { background: transparent; border: 0px; color: rgba(251, 248, 242, 0.55); padding: 6px 10px; font-family: inherit; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; border-radius: 999px; cursor: pointer; transition: color 200ms var(--ease), background 200ms var(--ease); flex-shrink: 0; min-width: 0px; }

.lang-bar button:hover { color: var(--cream); }

.lang-bar button.active { background: var(--gold); color: var(--ink); }

.stage { position: relative; z-index: 2; text-align: center; max-width: 640px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 22px; flex: 1 1 0%; justify-content: center; padding: 24px 0px; }

.mark { width: 64px; height: 64px; filter: drop-shadow(rgba(212, 162, 76, 0.3) 0px 8px 24px); }

.status { display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px 7px 12px; background: rgba(46, 157, 99, 0.12); border: 1px solid rgba(46, 157, 99, 0.4); border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: rgb(110, 212, 155); max-width: 100%; }

[dir="rtl"] .status { letter-spacing: 0px; padding: 7px 12px 7px 14px; }

.pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--green); position: relative; flex-shrink: 0; }

.pulse::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; background: rgba(46, 157, 99, 0.5); animation: 2s ease-out 0s infinite normal none running pulse; }

@keyframes pulse { 
  0% { transform: scale(0.6); opacity: 1; }
  100% { transform: scale(2.4); opacity: 0; }
}

h1 { font-family: var(--font-display); font-weight: 500; font-size: 38px; line-height: 1.05; letter-spacing: -0.02em; margin: 0px; color: var(--cream); max-width: 14ch; overflow-wrap: break-word; }

h1 em { font-style: italic; font-weight: 400; color: var(--gold); }

[dir="rtl"] h1 { font-family: var(--font-ar); letter-spacing: 0px; font-weight: 800; }

[dir="rtl"] h1 em { font-style: normal; font-weight: 800; }

.meta { margin-top: 6px; display: flex; align-items: center; justify-content: center; gap: 18px; padding: 14px 18px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 14px; max-width: 100%; }

.meta-item { display: flex; flex-direction: column; gap: 3px; align-items: center; min-width: 0px; }

.meta-num { font-family: var(--font-display); font-size: 18px; font-weight: 500; color: var(--cream); letter-spacing: -0.01em; line-height: 1; white-space: nowrap; }

.meta-num .pct { font-size: 11px; color: rgba(251, 248, 242, 0.5); }

.meta-lbl { font-size: 9.5px; color: rgba(251, 248, 242, 0.5); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }

[dir="rtl"] .meta-lbl { text-transform: none; letter-spacing: 0px; }

.meta-div { width: 1px; height: 22px; background: rgba(255, 255, 255, 0.1); flex-shrink: 0; }

.foot { width: 100%; display: flex; justify-content: center; position: relative; z-index: 2; padding: 0px 4px; }

.brand-foot { display: inline-flex; align-items: center; gap: 8px; color: rgba(251, 248, 242, 0.5); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; }

.brand-foot .fmark { width: 22px; height: 22px; border-radius: 6px; background: linear-gradient(135deg, var(--gold-light), var(--gold-deep)); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }

.brand-foot .fmark svg { width: 12px; height: 12px; }

.brand-foot-name { color: var(--cream); }

.brand-foot-sub { color: var(--gold); margin-left: 4px; letter-spacing: 0.12em; font-size: 9px; }

[dir="rtl"] .brand-foot-sub { margin-left: 0px; margin-right: 4px; }

@media (min-width: 540px) {
  body { padding: 24px; }
  .top, .foot { padding: 0px; }
  .stage { gap: 28px; padding: 32px 0px; }
  .mark { width: 72px; height: 72px; }
  .status { font-size: 13px; padding: 8px 16px 8px 14px; gap: 10px; }
  .pulse { width: 10px; height: 10px; }
  h1 { font-size: clamp(48px, 7vw, 84px); letter-spacing: -0.025em; }
  .meta { gap: 24px; padding: 16px 24px; border-radius: 16px; }
  .meta-num { font-size: 22px; }
  .meta-num .pct { font-size: 13px; }
  .meta-lbl { font-size: 11px; letter-spacing: 0.08em; }
  .meta-div { height: 28px; }
  .lang-bar { padding: 4px; gap: 2px; }
  .lang-bar button { padding: 8px 14px; font-size: 12px; letter-spacing: 0.06em; }
  .brand-foot { font-size: 12px; gap: 10px; }
  .brand-foot .fmark { width: 26px; height: 26px; border-radius: 7px; }
  .brand-foot .fmark svg { width: 14px; height: 14px; }
  .brand-foot-sub { font-size: 10px; }
}

@media (max-width: 360px) {
  h1 { font-size: 32px; }
  .stage { gap: 18px; }
  .meta { gap: 12px; padding: 12px 14px; }
  .meta-num { font-size: 16px; }
  .meta-lbl { font-size: 9px; }
  .lang-bar button { padding: 6px 8px; font-size: 10px; }
}

@media (max-height: 520px) and (orientation: landscape) {
  body { padding: 10px 16px; }
  .stage { gap: 14px; padding: 8px 0px; }
  .mark { width: 44px; height: 44px; }
  h1 { font-size: 30px; }
  .meta { padding: 10px 16px; }
}

.stage > * { opacity: 0; transform: translateY(10px); animation: enter 0.6s var(--ease) forwards; }

.stage > :nth-child(1) { animation-delay: 0.05s; }

.stage > :nth-child(2) { animation-delay: 0.15s; }

.stage > :nth-child(3) { animation-delay: 0.25s; }

.stage > :nth-child(4) { animation-delay: 0.38s; }

@keyframes enter { 
  100% { opacity: 1; transform: translateY(0px); }
}

@media (prefers-reduced-motion: reduce) {
  .stage > *, .pulse::after, body::before { animation: auto ease 0s 1 normal none running none !important; opacity: 1 !important; transform: none !important; }
}
