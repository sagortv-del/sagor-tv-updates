.modal_form .form_select.active { -webkit-border-image: url("i/combobox_act.png") 13 13 14 fill stretch !important; }

.modal_form .form_time, .modal_form .form_date { height: 5px; top: -13px; border-width: 13px 13px 14px; float: left; margin-top: -15px; line-height: 10px; margin-right: 10px; font-size: 18px; -webkit-border-image: url("i/input.png") 13 12 14 fill stretch !important; }

.modal_form .form_time.active, .modal_form .form_date.active { -webkit-border-image: url("i/input_act.png") 13 12 14 fill stretch !important; }

.modal_form .form_time.edit, .modal_form .form_date.edit { color: rgb(0, 0, 255); }

.modal_form .form_time .highlight, .modal_form .form_date .highlight { color: rgb(255, 0, 0); }

.modal_form .form_time { width: 45px; }

.modal_form .form_date { width: 88px; }

.modal_form .fixed_container { width: 280px; float: right; }

.modal_form .select_arrow { float: right; font-size: 20px; font-family: "Myriad Pro Cond", serif; position: relative; bottom: 11px; color: rgb(136, 136, 136); height: 40px; width: 10px; padding-right: 2px; }

